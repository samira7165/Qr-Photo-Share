# Port this app listens on (the Nescafe app uses 3000).
PORT=3001
# Public address of the Nescafe registration portal (HTTPS when online).
NESCAFE_API_URL="http://localhost:3000"
# Must be exactly the same value as PARTNER_SECRET in the Nescafe app. Long and random; keep it private.
PARTNER_SECRET="change-me-to-another-long-random-string"
# Needed to delete photos (deleting is switched off without it).
ADMIN_KEY=""
# Address the QR codes point to when deployed online.
BASE_URL=""
